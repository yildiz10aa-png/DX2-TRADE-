function hisibla(){

let high = parseFloat(document.getElementById("high").value);
let low = parseFloat(document.getElementById("low").value);

if(isNaN(high) || isNaN(low)){
alert("Maximum va Minimum ni kiriting!");
return;
}

let range = high - low;

// BUY (qaytish)
let buy = low + (range * 0.382);

// SELL (korreksiya)
let sell = high - (range * 0.382);

// Konsolidatsiya
let cons = low + (range * 0.50);

document.getElementById("range").innerHTML = range.toFixed(2);
document.getElementById("buy").innerHTML = buy.toFixed(2);
document.getElementById("sell").innerHTML = sell.toFixed(2);
document.getElementById("cons").innerHTML = cons.toFixed(2);

}
